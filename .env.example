# =============================================================================
# Conjiweb environment template
# Copy to .env and edit values before running install.sh
# =============================================================================

# Public access domain (required)
DOMAIN=chat.example.com

# Email used by Let's Encrypt for certificate notices (required)
EMAIL=you@example.com

# XMPP domain (defaults to DOMAIN in installer when left empty)
XMPP_DOMAIN=chat.example.com

# ---------------------------------------------------------------------------
# Secrets (leave empty to auto-generate during install)
# ---------------------------------------------------------------------------
DB_PASS=
REDIS_PASS=
SECRET_KEY=
XMPP_ADMIN_PASS=

# MinIO credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# Admin login for Conjiweb admin panel
ADMIN_USER=admin
ADMIN_PASS=

# Optional remote backup target for rclone (example: remote:conjiweb-backups)
BACKUP_REMOTE=
