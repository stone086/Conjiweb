# =============================================================================
#  Web Gajim V3 — 环境变量配置
#  复制此文件为 .env 并填写以下内容
#  cp .env.example .env && nano .env
# =============================================================================

# ── 必填项 ────────────────────────────────────────────────────────────────────

# 你的域名（不含 https://）
DOMAIN=chat.example.com

# 你的邮箱（用于 Let's Encrypt SSL 证书通知）
EMAIL=you@example.com

# XMPP 域名（通常和主域名相同，或者用子域名如 xmpp.example.com）
XMPP_DOMAIN=chat.example.com

# ── 自动生成（留空则安装时随机生成）────────────────────────────────────────────

# 数据库密码
DB_PASS=

# Redis 密码
REDIS_PASS=

# MinIO 管理员账号
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# JWT 密钥（留空自动生成）
SECRET_KEY=

# 后台管理员账号
ADMIN_USER=admin
ADMIN_PASS=
