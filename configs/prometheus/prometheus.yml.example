global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/rules/conjiweb-alerts.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

scrape_configs:
  - job_name: conjiweb-api
    metrics_path: /api/metrics
    scheme: https
    static_configs:
      - targets:
          - staging.example.com
